{
  "name": "reglass-material",
  "version": "0.0.0",
  "type": "module",
  "description": "re:glass material — a Material 3 + glassmorphism Svelte design kit",
  "license": "MIT",
  "svelte": "./src/lib/index.ts",
  "types": "./src/lib/index.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts"
    },
    "./theme": {
      "types": "./src/lib/theme/index.ts",
      "svelte": "./src/lib/theme/index.ts"
    },
    "./tokens.css": "./src/lib/tokens.css"
  },
  "scripts": {
    "dev": "vite dev --port 5180",
    "build": "svelte-kit sync && svelte-package",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^25.9.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
